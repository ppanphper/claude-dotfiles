# notify.conf — hooks/notify.sh 的配置文件
#
# 复制到 ~/.claude/notify.conf 后再编辑。它以 shell 文件的方式被 source，所以
# 写成 KEY=value，等号两侧不要留空格。每个键都是可选的；任何你省略的项都会
# 沿用这里展示的默认值。以 # 开头的行是注释。
#
# 首次安装时本示例会被复制成 ~/.claude/notify.conf。之后每次升级，安装脚本会用
# 最新模板刷新它（带上新版本新增的配置项与注释），并通过三方合并把你改过的值自动
# 迁移回来——你主动改动的设置不会丢，没碰过的项则会采用新的默认值。替换前旧文件会
# 备份为 notify.conf.bak.<时间戳>，你迁移过来的改动会集中放在文件末尾的
# “migrated overrides” 区块里。

# 总开关。设为 0 可关闭全部通知，且不改动 settings.json。
NOTIFY_ENABLED=1

# ── 各状态对应的通道（1=开，0=关）────────────────────────────────────────────
# 某个通道若所需的工具/配置缺失也会自动跳过，所以即便在跑不起来的环境里
# 打开它也是安全的。
#
#   done = Claude 完成一轮回复       （默认：安静）
#   wait = Claude 需要你输入/授权     （默认：响亮 —— 响铃 + 桌面弹窗）
#
# TITLE = 标签页标题字形（常被 Claude Code 覆盖 —— 见下文）
# BELL = 终端响铃   DESKTOP = 系统弹窗   SOUND = 播放声音
# TG = Telegram 推送（见下文）。iTerm2 标签页 COLOR 在下面单独配置。

NOTIFY_DONE_TITLE=0; NOTIFY_DONE_BELL=0; NOTIFY_DONE_DESKTOP=0; NOTIFY_DONE_SOUND=0; NOTIFY_DONE_TG=0
NOTIFY_WAIT_TITLE=0; NOTIFY_WAIT_BELL=1; NOTIFY_WAIT_DESKTOP=1; NOTIFY_WAIT_SOUND=0; NOTIFY_WAIT_TG=1

# ── iTerm2 标签页颜色（最可靠的「完成」视觉指示）─────────────────────────────
# 格式 "R G B"（0-255），留空 = 关闭。仅限 iTerm2。钩子会向 `claude` 进程的
# pty 写入 OSC 6（钩子没有控制终端，所以 /dev/tty 用不了 —— 它会沿进程树往上
# 找到真正的 pty）。和标题不同，Claude Code 从不覆盖标签页颜色。
# NOTIFY_TABCOLOR_RESET 会在你下一次提交提示词时（UserPromptSubmit）清掉颜色，
# 所以「带颜色的标签页 = 有未读输出」。
NOTIFY_DONE_TABCOLOR="40 200 80"     # 绿色
NOTIFY_WAIT_TABCOLOR="230 180 40"    # 琥珀色
NOTIFY_TABCOLOR_RESET=1
# 一条 Notification 有两种含义：真正的权限/决策提示（「Claude 需要你的授权…」）
# 或空闲提醒（「Claude 正在等待你的输入」）。只有前者会把标签页染成琥珀色并触发
# 响亮通道/Telegram；空闲那种会被降级归类为低调的「idle」。默认情况下 idle
# 不会改标签页颜色（保留绿色的「done」）；设一个 "R G B" 三元组可给它上色。
NOTIFY_IDLE_TABCOLOR=""              # 例如 "90 110 140" 是一种暗石板色的 idle 着色

# Claude 工作时在标签页上显示的「处理中」动画进度条 —— 你提交提示词时进度条
# 开始滚动，一轮结束（或 Claude 需要你介入）时停止。使用 iTerm2 的 OSC 9;4
# 不确定型进度条，通过 TERM_FEATURES 自动探测（iTerm2 3.6.x+）；在其他终端上
# 会被静默忽略。
NOTIFY_PROGRESS=1

# 在 iTerm2 上，桌面通道使用 iTerm2 原生的 OSC 9 通知，点击它可直接跳到对应
# 标签页。可见性由 iTerm2 自己决定（当前标签页已聚焦时不弹窗），所以这条路径
# 会忽略「聚焦静音」。设为 0 则改用 terminal-notifier/osascript。非 iTerm2 的
# 终端始终使用 terminal-notifier/osascript（mac）或 notify-send（linux）。
NOTIFY_DESKTOP_OSC9=1

# ── 标签页标题字形（仅当上面对应的 *_TITLE 为 1 时生效）──────────────────────
# Claude Code 自己管理终端标题，并会在下一次渲染时覆盖掉这里设置的内容。
# 想让它保留，还需在 ~/.claude/settings.json 中设置：
#   "env": { "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1" }
# 可填任意字符串；emoji 会显示为一个彩色圆点。例如 🟢 🔵 🟡 🔴 ✅ ⏳ ●
NOTIFY_GLYPH_DONE="🟢"
NOTIFY_GLYPH_WAIT="🟡"

# 状态文案（显示在标题 / 桌面 / Telegram 中）。可自行本地化。
NOTIFY_LABEL_DONE="Claude done"
NOTIFY_LABEL_WAIT="Claude waiting"

# ── 提示音文件（仅当对应的 *_SOUND 为 1 时生效）──────────────────────────────
# 留空 → 使用平台默认音。macOS：任意 /System/Library/Sounds/*.aiff
#（Glass、Funk、Hero、Ping、Submarine、Pop…）。Linux：paplay 能播放的路径。
# 小技巧：给 done 和 wait 各选一个明显不同的声音，耳朵很快就能分辨。
NOTIFY_SOUND_DONE=""
NOTIFY_SOUND_WAIT=""

# ── 消息内容 ─────────────────────────────────────────────────────────────────
# 在桌面弹窗和 Telegram 消息里附带 git 分支 + 一行摘要（最后一条助手消息 /
# 通知文本）。
NOTIFY_SUMMARY=1
NOTIFY_SUMMARY_MAX=200      # 桌面/标题摘要：截断到这么多字符

# Telegram 消息以 HTML 形式发送（parse_mode=HTML）：助手的 **加粗** / `代码` /
# # 标题 / - 列表会被正确渲染，而不是显示原始 markdown，表格则会折叠成「a · b」
# 这样的行。Telegram 能容纳的内容比桌面弹窗多，所以给它单独（更大）的长度预算。
NOTIFY_TG_SUMMARY_MAX=600

# 把完整回复渲染成一张图片再发送，替代纯文本消息 —— 不截断、网页级排版
#（语法高亮的代码、表格、标题）。需要 python3 + 无头 Chrome（hooks/render-reply.py）；
# 若两者任一缺失，会静默回退到上面的 HTML 文本消息。超出 Telegram 图片限制的
# 超长回复会以文件/PDF 形式发送（sendDocument），确保内容不被裁剪。
# NOTIFY_TG_IMAGE_WIDTH 是渲染宽度（像素，2 倍缩放前）。
NOTIFY_TG_IMAGE=0
NOTIFY_TG_IMAGE_WIDTH=760
# 智能分流：回复短于这么多字符就直接发"完整文本"（不渲染图片），≥ 此值才渲染成图片
# —— 短回复保持轻快、可复制，只有长回复才变成图片。这个值同时是这类文本的长度上限，
# 建议 ≤ 3000，以免 HTML 化后超出 Telegram 4096 字符的消息上限。仅在图片模式开启时生效。
NOTIFY_TG_IMAGE_MIN_CHARS=900
# 图片里的状态强调色（顶部状态条/状态圆点/链接/列表标记/引用左条）：完成用绿、
# 等待输入用琥珀，一眼区分 done 与 wait。任意 CSS 颜色字符串。
NOTIFY_TG_IMAGE_ACCENT_DONE="#3fb950"
NOTIFY_TG_IMAGE_ACCENT_WAIT="#d29922"
# 图片配色主题：dark（默认）或 light（明亮版式）。
NOTIFY_TG_IMAGE_THEME=dark
# 在标题下方显示一行元信息（主机 · cwd · 分支 · 时间），便于多机/多会话区分。1=开。
NOTIFY_TG_IMAGE_META=1
# 语义着色：状态符号（✓✗⚠）、行内代码状态值（true/false/rc=0…）、中英关键词词典、
# GitHub 风格 > [!WARNING] / [!TIP] 提示卡片 —— 按重要程度上色。1=开。符号/代码/卡片
# 是客观信号、零误伤；关键词词典对中文语义可能偶有误标，介意可设 0 关闭。
NOTIFY_TG_IMAGE_SEMANTIC=1

# ── 聚焦感知静音（仅限 macOS）────────────────────────────────────────────────
# 当某个终端是最前台应用时 —— 也就是你正盯着它看 —— 抑制本地的响亮通道
#（响铃/桌面/声音）。静默的标签页字形和远程 Telegram 推送仍会触发（你可能开着
# 终端就走开了）。需要给你的终端 App 授予「辅助功能」权限：系统设置 >
# 隐私与安全性 > 辅助功能。若被拒绝，会「失败即放行」（你照样收得到通知）。
# NOTIFY_TERMINAL_APPS 是算作「终端」的最前台应用名（空格分隔）—— 你的终端
# 不在列表里就加上。
NOTIFY_FOCUS_MUTE=1
NOTIFY_TERMINAL_APPS="Terminal iTerm2 Ghostty kitty WezTerm Alacritty Warp Code Hyper Tabby rio"

# ── Telegram 推送（远程 —— 离开座位也能收到通知）────────────────────────────
# 1. 用 @BotFather 创建一个机器人 → 把 token 填进 NOTIFY_TG_BOT_TOKEN。
# 2. 获取你的 chat id：给机器人发条消息，然后打开
#    https://api.telegram.org/bot<TOKEN>/getUpdates 读取 result[].message.chat.id
#   （个人聊天的 chat id，或以 -100… 开头的群/超级群 id）。
# 把 token 留空即可禁用。通过上面的 *_TG 按状态分别控制。
NOTIFY_TG_BOT_TOKEN=""
NOTIFY_TG_CHAT_ID=""

# 每个 Claude 会话一个论坛话题（topic），让每个会话各成一条独立线程。该聊天
# 必须是论坛超级群（群 → 编辑 → 打开「话题」），且机器人是拥有「管理话题」
# 权限的管理员。其 id 会以一行 JSON {"thread":"…","title":"…"} 缓存在
# ~/.claude/.tg_topic_<session_id> 中，供后续消息复用。
# 关闭 → 直接给群发普通消息，并以项目名作前缀。
NOTIFY_TG_FORUM=0

# 用会话标题来命名每个会话的话题 —— 即 Claude 的 `ai-title`，它会在几轮之后才
# 出现；回退顺序为首条提示词，再到「project ⎇ branch」。当该标题变化时话题会被
# 重命名。0 = 使用静态命名「project ⎇ branch · <短会话 id>」。重命名需要机器人的
# 「管理话题」管理员权限。
NOTIFY_TG_TOPIC_TITLE=1
# 创建话题时，发一条上下文信息（项目 / 分支 / cwd / 会话 id）并把它置顶到话题
# 顶部，这样标题就能只保留会话名。需要机器人的「置顶消息」管理员权限。
# 0 = 不发置顶上下文消息。
NOTIFY_TG_TOPIC_PIN=1

# 本机的标识名，会追加到置顶上下文里 —— 多台电脑共用同一个 bot / 群时，用它一眼
# 区分消息来自哪台机器。留空 → 运行时自动回退到短主机名（hostname -s）。安装脚本
# 会在此处 seed 当前主机名，你可改成更友好的名字（如「公司Mac」「家里」），之后重跑
# 安装也不会被覆盖。
NOTIFY_TG_HOST_LABEL=""

# 会话结束时（SessionEnd 钩子），如何处理它的论坛话题：
#   close  = 归档它 —— 保留历史，折叠进群组的「已关闭」列表
#   delete = 删除话题及其全部消息（不可逆）
#   cache  = 只删本地的 ~/.claude/.tg_topic_<id> 文件，保留话题本身
#   off    = 什么都不做
# 除 "off" 外，无论哪种都会删掉每个会话的缓存文件。关闭/删除话题需要机器人是
# 拥有「管理话题」权限的群管理员。
NOTIFY_TG_TOPIC_CLEANUP=close

# 在 Telegram 论坛话题中回复，将文本注入原 Claude TUI。这不使用官方
# 不使用官方 Channels：SessionStart 会确保一个全局 gateway 运行，它用 Telegram 服务器挂起的
# getUpdates 长轮询接收消息，空闲时不会高频空转。必须填允许控制 Claude 的 Telegram
# 数字 user id，多个用逗号或空格分隔。安装器只在此项缺失时引导填写，不会从 chat id
# 或其他文件推断授权身份。优先支持 tmux，其次是 iTerm2。
NOTIFY_TG_REPLY=0
NOTIFY_TG_REPLY_ALLOW_FROM=""  # 例如 "123456789"
# 若希望每轮 Stop 完成后也创建/更新 topic 并可回复，打开它（默认 done 很安静）。
# NOTIFY_DONE_TG=1
